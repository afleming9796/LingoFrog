{
  "manifest_version": 3,
  "name": "LingoFrog",
  "version": "1.3.0",
  "description": "Gmail autocomplete powered by you. Your links, your phrases, at your service.",
  "permissions": ["storage", "activeTab", "scripting"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/lf16.png",
      "32": "icons/lf32.png",
      "48": "icons/lf48.png",
      "128": "icons/lf128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["phrase-format.js", "trie.js", "quick-insert.js", "content.js"],
      "css": ["lingofrog.css"],
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["icons/icon48.png", "icons/icon128.png"],
      "matches": ["https://mail.google.com/*"]
    }
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+L"
      },
      "description": "Open LingoFrog"
    },
    "open_phrases": {
      "suggested_key": {
        "default": "Alt+P"
      },
      "description": "Open LingoFrog on the Phrases tab"
    },
    "insert_link": {
      "suggested_key": {
        "default": "Ctrl+Shift+L"
      },
      "description": "Insert a link in the text box you're in (in Gmail, links highlighted text)"
    },
    "insert_phrase": {
      "suggested_key": {
        "default": "Ctrl+Shift+P"
      },
      "description": "Insert a phrase in the text box you're in (in Gmail, saves highlighted text)"
    }
  }
}