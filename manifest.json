{
  "manifest_version": 3,
  "name": "LingoFrog",
  "version": "1.2.1",
  "description": "Gmail autocomplete powered by you. Your links, your phrases, at your service.",
  "permissions": ["storage"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/lf16.png",
      "32": "icons/lf32.png",
      "48": "icons/lf48.png",
      "128": "icons/lf128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["trie.js", "content.js"],
      "css": ["lingofrog.css"],
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["icons/icon48.png", "icons/icon128.png"],
      "matches": ["https://mail.google.com/*"]
    }
  ]
}